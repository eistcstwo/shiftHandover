//Immutable Class
//defensive copy of collage(non primitive)
final class Student1{
    private final int age;
    private final String name;
    private final Colllege1 c;

    Student1(int age, String name, Colllege1 c){
        this.age = age;
        this.name = name;
        this.c=new Colllege1(c.name, c.address);
    }

    //getter
    public int getAge(){
        return this.age;
    }

    public String getName(){
        return this.name;
    }

    public Colllege1 getC(){
        return new Colllege1(this.c.name, this.c.address);
    }
}

class  Colllege1{
    String name;
    String address;

    Colllege1(String name, String address){
        this.address= address;
        this.name = name;
    }
}



