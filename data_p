//Immutable Class

final class Student{
    private final int age;
    private final String name;
    private final Colllege c;

    Student(int age, String name, Colllege c){
        this.age = age;
        this.name = name;
        this.c=c;
    }

    //getter
    public int getAge(){
        return this.age;
    }

    public String getName(){
        return this.name;
    }

    public Colllege getC(){
        return this.c;
    }

}


class  Colllege{
    String name;
    String address;

    Colllege(String name, String address){
        this.address= address;
        this.name = name;
    }
}

public class demo4 {
    public static void main(String[] args){

        Colllege1 c = new Colllege1("terna" , "navi mumbai");
